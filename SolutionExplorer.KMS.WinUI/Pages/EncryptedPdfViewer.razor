@page "/pdf-viewer/{DocumentId:int}"
@inject IJSRuntime JS
@inject HttpClient Http

<Spinner @ref="spinner" />

<div id="@_containerId" class="encrypted-pdf-viewer"
     style="width:@Width; height:@Height; border:1px solid #e0e0e0; border-radius:6px; overflow:auto;">
</div>

@code {
    [Parameter] public int DocumentId { get; set; }   // از آی‌دی سند استفاده می‌کنیم
    [Parameter] public string Height { get; set; }
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public double InitialScale { get; set; } = 1.0;

    private Spinner spinner = new();

    private string _containerId = "epv_" + Guid.NewGuid().ToString("N");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        //if (!firstRender) return;

        if (DocumentId <= 0)
        {
            Console.WriteLine("EncryptedPdfViewer: DocumentId is invalid.");
            return;
        }

        try
        {
            spinner.ShowLoadingSpinner();
            // وب سرویس رو صدا بزن
            var response = await Http.GetAsync($"http://185.7.212.79:5000/api/Document/generate-encrypted-pdf/{DocumentId}");
            //var response = await Http.GetAsync($"http://185.7.212.79:9091/api/Document/generate-encrypted-pdf/{DocumentId}");
            //var response = await Http.GetAsync($"https://localhost:7180/api/Document/generate-encrypted-pdf/{DocumentId}");
            if (!response.IsSuccessStatusCode)
            {
                Console.WriteLine($"EncryptedPdfViewer: request failed: {response.StatusCode}");
                return;
            }

            // داده انکریپت شده (بایت‌ها) رو بگیر
            var encryptedBytes = await response.Content.ReadAsByteArrayAsync();

            // دیکریپت کن
            using var encryptedStream = new MemoryStream(encryptedBytes);
            using var decryptedStream = Utilities.EncryptedPdfService.DecryptPdfToStream(encryptedStream);

            byte[] buffer = decryptedStream.ToArray();
            string base64 = Convert.ToBase64String(buffer);

            // نمایش در مرورگر
            await JS.InvokeVoidAsync("encryptedPdfViewer.loadPdf", _containerId, base64);

            spinner.HideLoadingSpinner();
        }
        catch (Exception ex)
        {
            Console.WriteLine("EncryptedPdfViewer Error: " + ex);
        }
    }
}