@page "/pdf-viewer/{FilePath}"
@using System.IO
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div id="@_containerId" class="encrypted-pdf-viewer" style="width:@Width; height:@Height; border:1px solid #e0e0e0; border-radius:6px; overflow:auto;">
    <!-- toolbar و صفحات توسط JS ساخته می‌شود -->
</div>

@code {
    [Parameter] public string FilePath { get; set; } = string.Empty; // مثال: "invoice1.pdf.enc"
    [Parameter] public string Height { get; set; } = "600px";
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public double InitialScale { get; set; } = 1.0; // می‌تونی مقدار اولیه زوم بدهی

    private string _containerId = "epv_" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<EncryptedPdfViewer>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (string.IsNullOrWhiteSpace(FilePath))
        {
            Console.WriteLine("EncryptedPdfViewer: FilePath is empty.");
            return;
        }

        string fullPath = Path.Combine(
            @"C:\Users\Farzam\source\repos\SolutionExplorer.KMS\SolutionExplorer.KMS.WinUI\wwwroot\EncryptedFiles",
            FilePath);

        if (!System.IO.File.Exists(fullPath))
        {
            Console.WriteLine($"EncryptedPdfViewer: file not found: {fullPath}");
            return;
        }

        try
        {
            using var decryptedStream = Utilities.EncryptedPdfService.DecryptPdfToStream(fullPath);
            byte[] buffer = decryptedStream.ToArray();
            string base64 = Convert.ToBase64String(buffer);

            // ✅ فراخوانی نسخه جدید JS
            await JS.InvokeVoidAsync("encryptedPdfViewer.loadPdf", _containerId, base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine("EncryptedPdfViewer Error: " + ex);
        }
    }


