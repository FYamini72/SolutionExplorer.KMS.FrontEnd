@using SolutionExplorer.KMS.SharedUI.Dtos.EquipmentDtos
@inject IHttpService _httpService
@inject IJSRuntime _jsRuntime

@if (showSpinner)
{
    <Spinner />
}
else
{
    <div class="container">
        <div class="text-center mt-5">
            <h1 class="page-title">
                @(this.Id.HasValue ? "ویرایش دستگاه" : "ایجاد دستگاه جدید")
            </h1>
        </div>

        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="card mt-2 mx-auto beauty-card">
                    <div class="card-body bg-light">
                        <div class="container">
                            <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
                                <DataAnnotationsValidator />
                                <div class="controls">
                                    <input type="hidden" @bind-value="Model.Id" />

                                    <div class="row row-margin-10">
                                        <div class="form-group col-md-6">
                                            <label>
                                                @(ApplicationHelper.GetDisplayName<EquipmentCreateDto>(nameof(EquipmentCreateDto.Title)))
                                            </label>
                                            <InputText class="form-control" @bind-Value="Model.Title" />
                                            <ValidationMessage For="@(() => Model.Title)" />
                                        </div>
                                    
                                        <div class="form-group col-md-6">
                                            <label>
                                                @(ApplicationHelper.GetDisplayName<EquipmentCreateDto>(nameof(EquipmentCreateDto.Code)))
                                            </label>
                                            <InputText class="form-control" @bind-Value="Model.Code" />
                                            <ValidationMessage For="@(() => Model.Code)" />
                                        </div>
                                    </div>

                                    <div class="row row-margin-10">
                                        <div class="form-group col-md-6">
                                            <label>
                                                @(ApplicationHelper.GetDisplayName<EquipmentCreateDto>(nameof(EquipmentCreateDto.EquipmentModel)))
                                            </label>
                                            <InputText class="form-control" @bind-Value="Model.EquipmentModel" />
                                            <ValidationMessage For="@(() => Model.EquipmentModel)" />
                                        </div>
                                   
                                        <div class="form-group col-md-6">
                                            <label>
                                                @(ApplicationHelper.GetDisplayName<EquipmentCreateDto>(nameof(EquipmentCreateDto.SerialNo)))
                                            </label>
                                            <InputText class="form-control" @bind-Value="Model.SerialNo" />
                                            <ValidationMessage For="@(() => Model.SerialNo)" />
                                        </div>
                                    </div>

                                    <div class="row row-margin-10">
                                        <div class="form-group col-md-6">
                                            <label>
                                                @(ApplicationHelper.GetDisplayName<EquipmentCreateDto>(nameof(EquipmentCreateDto.Manufacturer)))
                                            </label>
                                            <InputText class="form-control" @bind-Value="Model.Manufacturer" />
                                            <ValidationMessage For="@(() => Model.Manufacturer)" />
                                        </div>
                                    
                                        <div class="form-group col-md-6">
                                            <label>
                                                @(ApplicationHelper.GetDisplayName<EquipmentCreateDto>(nameof(EquipmentCreateDto.ManufactureCountry)))
                                            </label>
                                            <InputText class="form-control" @bind-Value="Model.ManufactureCountry" />
                                            <ValidationMessage For="@(() => Model.ManufactureCountry)" />
                                        </div>
                                    </div>

                                    <div class="row row-margin-10">
                                        <div class="form-group col-md-6">
                                            <label>
                                                @(ApplicationHelper.GetDisplayName<EquipmentCreateDto>(nameof(EquipmentCreateDto.FirstConfirmerUserId)))
                                            </label>
                                            <InputSelect class="form-select" @bind-value="Model.FirstConfirmerUserId">
                                                <option value="">انتخاب کنید...</option>
                                                @foreach (var user in UsersKeyValue)
                                                {
                                                    <option value="@user.Key">@user.Value</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="@(() => Model.FirstConfirmerUserId)" />
                                        </div>

                                        <div class="form-group col-md-6">
                                            <label>
                                                @(ApplicationHelper.GetDisplayName<EquipmentCreateDto>(nameof(EquipmentCreateDto.SecondConfirmerUserId)))
                                            </label>
                                            <InputSelect class="form-select" @bind-value="Model.SecondConfirmerUserId">
                                                <option value="">انتخاب کنید...</option>
                                                @foreach (var user in UsersKeyValue)
                                                {
                                                    <option value="@user.Key">@user.Value</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="@(() => Model.SecondConfirmerUserId)" />
                                        </div>
                                    </div>

                                    <div class="row row-margin-10">
                                        <div class="col-md-6">
                                            <input type="submit" class="btn btn-success btn-send pt-2 btn-block" value="ثبت اطلاعات" />
                                        </div>
                                        <div class="col-md-6">
                                            <button type="button" @onclick="Cancel" class="btn btn-primary btn-send pt-2 btn-block">انصراف</button>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<bool> OnSavedChanges { get; set; }
    [Parameter] public int? Id { get; set; } = null;

    public EquipmentCreateDto Model { get; set; } = new();
    private List<KeyValuePair<int, string>> UsersKeyValue = new();

    NotificationClassName ClassName = NotificationClassName.Success;
    string MessageBody = "عملیات با موفقت انجام شد.";
    private bool showSpinner;

    protected override async Task OnParametersSetAsync()
    {
        if (!Id.HasValue)
        {
            var apiResult = await _httpService
                .GetByFilterAsync<IdentifierSearchDto, ApiResult<BaseGridDto<IdentifierDisplayDto>>>("api/Identifier/GetByFilter", new IdentifierSearchDto() { GetAllItems = true, DocumentNumber = "B-001-0001" });

            Model.IdentifierId = apiResult?.Data?.Data?.FirstOrDefault()?.Id ?? 0;
            return;
        }

        showSpinner = true;

        try
        {
            var apiResult = await _httpService.GetAsync<ApiResult<EquipmentDisplayDto>>($"api/Equipment/{Id}");

            if (apiResult?.IsSuccess ?? false)
            {
                Model = apiResult?.Data?.Adapt<EquipmentCreateDto>() ?? new();
            }
            else
            {
                ClassName = NotificationClassName.Error;
                MessageBody = apiResult?.Message ?? "خطایی رخ داده است. لطفا با پشتیبانی تماس بگیرید.";
                await ShowMessage();
            }
        }
        catch (Exception)
        {
            ClassName = NotificationClassName.Error;
            MessageBody = "خطا در دریافت اطلاعات کاربر.";
            await ShowMessage();
        }
        finally
        {
            showSpinner = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var apiResult = await _httpService
            .GetByFilterAsync<UserSearchDto, ApiResult<List<KeyValuePair<int, string>>>>("api/User/GetByFilterForDropDown", new());

        UsersKeyValue = apiResult?.Data?.ToList() ?? new();
    }

    private async Task HandleValidSubmit()
    {
        showSpinner = true;
        try
        {
            ApiResult<EquipmentDisplayDto>? apiResult = null;

            if (Model.Id > 0)
                apiResult = await _httpService.PutAsync<EquipmentCreateDto, ApiResult<EquipmentDisplayDto>>("api/Equipment", Model);
            else
                apiResult = await _httpService.PostAsync<EquipmentCreateDto, ApiResult<EquipmentDisplayDto>>("api/Equipment", Model);

            if (!apiResult?.IsSuccess ?? false)
            {
                ClassName = NotificationClassName.Error;
                MessageBody = apiResult?.Message ?? "خطایی رخ داده است. لطفا با پشتیبانی تماس بگیرید.";
                await ShowMessage();
                return;
            }

            await OnSavedChanges.InvokeAsync(true);
        }
        catch (Exception)
        {
            ClassName = NotificationClassName.Error;
            MessageBody = "خطایی رخ داده است. لطفا با پشتیبانی تماس بگیرید.";
            await ShowMessage();
        }
        finally
        {
            showSpinner = false;
        }
    }

    private Task Cancel() => OnSavedChanges.InvokeAsync(false);

    private Task ShowMessage() => _jsRuntime.InvokeVoidAsync("showToast", ClassName.ToDisplay(), MessageBody).AsTask();
}
