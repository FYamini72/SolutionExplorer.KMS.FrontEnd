@using SolutionExplorer.KMS.SharedUI.Dtos.PersonnelColorBlindnessTestDtos
@if (showSpinner)
{
	<Spinner />
}
else
{
	<div class="container">
		<div class="text-center mt-5">
			<h1 class="page-title">
				ایجاد پرسنل جدید
			</h1>
		</div>

		<div class="row">
			<div class="col-lg-10 mx-auto">
				<div class="card mt-2 mx-auto beauty-card">
					<div class="card-body bg-light">
						<div class="container">
							<EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
								<DataAnnotationsValidator />

								<div class="controls">

									<!-- Users -->
									<div class="row row-margin-10">
										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelColorBlindnessTestCreateDto>(nameof(PersonnelColorBlindnessTestCreateDto.TestDate)))
											</label>
											<PersianDatePicker Value="@Model.TestDate"
															   ValueChanged="@((val) => Model.TestDate = val ?? DateTime.Now)"
															   Required="true"
															   ShowToolbar="false" />
										</div>
										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelColorBlindnessTestCreateDto>(nameof(PersonnelColorBlindnessTestCreateDto.PersonnelId)))
											</label>
											<InputSelect class="form-select" @bind-Value="Model.PersonnelId">
												<option value="">انتخاب کنید...</option>
												@foreach (var user in UsersKeyValue)
												{
													<option value="@user.Key">@user.Value</option>
												}
											</InputSelect>
										</div>

									</div>

									<!-- Users -->
									<div class="row row-margin-10">
										
										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelColorBlindnessTestCreateDto>(nameof(PersonnelColorBlindnessTestCreateDto.FirstConfirmerUserId)))
											</label>
											<InputSelect class="form-select" @bind-Value="Model.FirstConfirmerUserId">
												<option value="">انتخاب کنید...</option>
												@foreach (var user in UsersKeyValue)
												{
													<option value="@user.Key">@user.Value</option>
												}
											</InputSelect>
										</div>

										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelColorBlindnessTestCreateDto>(nameof(PersonnelColorBlindnessTestCreateDto.SecondConfirmerUserId)))
											</label>
											<InputSelect class="form-select" @bind-Value="Model.SecondConfirmerUserId">
												<option value="">انتخاب کنید...</option>
												@foreach (var user in UsersKeyValue)
												{
													<option value="@user.Key">@user.Value</option>
												}
											</InputSelect>
										</div>
									</div>

									<!-- Users -->
									<div class="row row-margin-10">
										<div class="form-group col-md-3">
											<label class="form-check-label">
												<InputCheckbox class="form-check-input" @bind-Value="Model.RedColorDetection" />
												@(ApplicationHelper.GetDisplayName<PersonnelColorBlindnessTestCreateDto>(nameof(PersonnelColorBlindnessTestCreateDto.RedColorDetection)))
											</label>
										</div>
										
										<div class="form-group col-md-3">
											<label class="form-check-label">
												<InputCheckbox class="form-check-input" @bind-Value="Model.BlueColorDetection" />
												@(ApplicationHelper.GetDisplayName<PersonnelColorBlindnessTestCreateDto>(nameof(PersonnelColorBlindnessTestCreateDto.BlueColorDetection)))
											</label>
										</div>
										
										<div class="form-group col-md-3">
											<label class="form-check-label">
												<InputCheckbox class="form-check-input" @bind-Value="Model.YellowColorDetection" />
												@(ApplicationHelper.GetDisplayName<PersonnelColorBlindnessTestCreateDto>(nameof(PersonnelColorBlindnessTestCreateDto.YellowColorDetection)))
											</label>
										</div>

										<div class="form-group col-md-3">
											<label class="form-check-label">
												<InputCheckbox class="form-check-input" @bind-Value="Model.IsConfirmed" />
												@(ApplicationHelper.GetDisplayName<PersonnelColorBlindnessTestCreateDto>(nameof(PersonnelColorBlindnessTestCreateDto.IsConfirmed)))
											</label>
										</div>
									</div>

									<!-- Actions -->
									<div class="row row-margin-10">
										<div class="col-md-6">
											<input type="submit" class="btn btn-success btn-send pt-2 btn-block" value="ثبت اطلاعات" />
										</div>
										<div class="col-md-6">
											<button type="button" class="btn btn-primary btn-send pt-2 btn-block" @onclick="Cancel">
												انصراف
											</button>
										</div>
									</div>

								</div>
							</EditForm>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
