@page "/LabReportHistory"
@using SolutionExplorer.KMS.SharedUI.Dtos.LabReportHistoryDtos
@inject IHttpService httpHelper
@inject IJSRuntime JSRuntime
@attribute [Authorize]

@if (formState is FormState.Edit or FormState.Create)
{
	<LabReportHistoryCreate OnSavedChanges="HandleCreateCompleted" Id="@id" />
}
else
{
	<div class="mb-3 d-flex flex-wrap gap-2">
		<button class="btn btn-outline-info btn-sm" type="button" @onclick="OnSearch">
			<span aria-hidden="true" style="vertical-align: sub;" class="bi bi-arrow-clockwise"></span>
		</button>

		<button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#searchFormCollapse" aria-expanded="false" aria-controls="searchFormCollapse">
			<i class="bi bi-search"></i>
			فرم جستجو
		</button>

		<button class="btn btn-success btn-sm" @onclick="CreateNewItem">
			<i class="bi bi-plus-circle"></i>
			درج رکورد جدید
		</button>
	</div>

	<div class="collapse" id="searchFormCollapse">
		<div class="card card-body mb-4 shadow-sm">
			<form class="row g-3" @onreset="ClearForm">

				<div class="col-md-4 col-sm-6">
					<label class="form-label fw-semibold">
						@(ApplicationHelper.GetDisplayName<LabReportHistorySearchDto>(nameof(LabReportHistorySearchDto.PatientName)))
					</label>
					<input type="text" class="form-control" @bind="searchModel.PatientName" />
				</div>

				<div class="col-md-4 col-sm-6">
					<label class="form-label fw-semibold">
						@(ApplicationHelper.GetDisplayName<LabReportHistorySearchDto>(nameof(LabReportHistorySearchDto.AdmissionNumber)))
					</label>
					<input type="text" class="form-control" @bind="searchModel.AdmissionNumber" />
				</div>

				<div class="col-md-4 col-sm-6">
					<label class="form-label fw-semibold">
						@(ApplicationHelper.GetDisplayName<LabReportHistorySearchDto>(nameof(LabReportHistorySearchDto.ReporterUserId)))
					</label>
					<select class="form-select" @bind="searchModel.ReporterUserId">
						<option value="">انتخاب کنید...</option>
						@foreach (var user in UsersKeyValue)
						{
							<option value="@user.Key">@user.Value</option>
						}
					</select>
				</div>

				<div class="col-md-4 col-sm-6">
					<label class="form-label fw-semibold">
						@(ApplicationHelper.GetDisplayName<LabReportHistorySearchDto>(nameof(LabReportHistorySearchDto.ReceiverUserId)))
					</label>
					<select class="form-select" @bind="searchModel.ReceiverUserId">
						<option value="">انتخاب کنید...</option>
						@foreach (var user in UsersKeyValue)
						{
							<option value="@user.Key">@user.Value</option>
						}
					</select>
				</div>
				<div class="col-md-4 col-sm-6">
					<label class="form-label fw-semibold">
						@(ApplicationHelper.GetDisplayName<LabReportHistorySearchDto>(nameof(LabReportHistorySearchDto.IsCritical)))
					</label>
					<InputSelect class="form-select" @bind-Value="searchModel.IsCritical">
						<option value="0">انتخاب کنید...</option>
						<option value="1">بحرانی</option>
						<option value="2">عادی</option>
					</InputSelect>
				</div>

				<div class="col-md-4 col-sm-6">
					<label class="form-label fw-semibold">
						@(ApplicationHelper.GetDisplayName<LabReportHistorySearchDto>(nameof(LabReportHistorySearchDto.FromReportDate)))
					</label>
					<PersianDatePicker 
						Value="@searchModel.FromReportDate" 
						ValueChanged="@((val) => searchModel.FromReportDate = val)" 
						Required="false" 
						ShowToolbar="false" />
				</div>

				<div class="col-md-4 col-sm-6">
					<label class="form-label fw-semibold">
						@(ApplicationHelper.GetDisplayName<LabReportHistorySearchDto>(nameof(LabReportHistorySearchDto.ToReportDate)))
					</label>
					@* <input type="datetime-local" class="form-control" @bind="searchModel.ToReportDate" /> *@
					<PersianDatePicker 
						Value="@searchModel.ToReportDate" 
						ValueChanged="@((val) => searchModel.ToReportDate = val)" 
						Required="false" 
						ShowToolbar="false" />
				</div>

				<div class="col-12 text-end mt-3">
					<button type="reset" class="btn btn-outline-secondary px-4 me-2">
						<i class="bi bi-trash"></i> پاک کردن
					</button>
					<button type="button" class="btn btn-primary px-4" @onclick="OnSearch">
						<i class="bi bi-search"></i> جستجو
					</button>
				</div>
			</form>
		</div>
	</div>

	<MudTable ServerData="ServerReload" Dense="true" Striped="true" Hover="true" @ref="table">
		<HeaderContent>
			<MudTh>@(ApplicationHelper.GetDisplayName<LabReportHistoryDisplayDto>(nameof(LabReportHistoryDisplayDto.ReportDateTime)))</MudTh>
			<MudTh>@(ApplicationHelper.GetDisplayName<LabReportHistoryDisplayDto>(nameof(LabReportHistoryDisplayDto.PatientName)))</MudTh>
			<MudTh>@(ApplicationHelper.GetDisplayName<LabReportHistoryDisplayDto>(nameof(LabReportHistoryDisplayDto.AdmissionNumber)))</MudTh>
			<MudTh>@(ApplicationHelper.GetDisplayName<LabReportHistoryDisplayDto>(nameof(LabReportHistoryDisplayDto.ReporterUserFullName)))</MudTh>
			<MudTh>@(ApplicationHelper.GetDisplayName<LabReportHistoryDisplayDto>(nameof(LabReportHistoryDisplayDto.ReceiverUserFullName)))</MudTh>
			<MudTh>@(ApplicationHelper.GetDisplayName<LabReportHistoryDisplayDto>(nameof(LabReportHistoryDisplayDto.IsCritical)))</MudTh>
			<MudTh>@(ApplicationHelper.GetDisplayName<LabReportHistoryDisplayDto>(nameof(LabReportHistoryDisplayDto.FirstConfirmerUserFullName)))</MudTh>
			<MudTh>@(ApplicationHelper.GetDisplayName<LabReportHistoryDisplayDto>(nameof(LabReportHistoryDisplayDto.SecondConfirmerUserFullName)))</MudTh>
			<MudTh>عملیات</MudTh>
		</HeaderContent>
		<RowTemplate>
			<MudTd DataLabel="@(nameof(LabReportHistoryDisplayDto.ReportDateTime))" Style="direction:ltr">@context.ReportDateTime.ToString("yyyy/MM/dd HH:mm")</MudTd>
			<MudTd DataLabel="@(nameof(LabReportHistoryDisplayDto.PatientName))">@context.PatientName</MudTd>
			<MudTd DataLabel="@(nameof(LabReportHistoryDisplayDto.AdmissionNumber))">@context.AdmissionNumber</MudTd>
			<MudTd DataLabel="@(nameof(LabReportHistoryDisplayDto.ReporterUserFullName))">@context.ReporterUserFullName</MudTd>
			<MudTd DataLabel="@(nameof(LabReportHistoryDisplayDto.ReceiverUserFullName))">@context.ReceiverUserFullName</MudTd>
			<MudTd DataLabel="@(nameof(LabReportHistoryDisplayDto.IsCritical))">
				@(context.IsCritical ? "بحرانی" : "عادی")
			</MudTd>
			<MudTd DataLabel="@(nameof(LabReportHistoryDisplayDto.FirstConfirmerUserFullName))">@context.FirstConfirmerUserFullName</MudTd>
			<MudTd DataLabel="@(nameof(LabReportHistoryDisplayDto.SecondConfirmerUserFullName))">@context.SecondConfirmerUserFullName</MudTd>
			<MudTd DataLabel="@(nameof(LabReportHistoryDisplayDto.Id))" Style="width: 150px;">
				<MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Medium" OnClick="@(() => EditItem(context.Id))"></MudIconButton>
				<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Medium" OnClick="@(() => DeleteItem(context.Id))"></MudIconButton>
			</MudTd>
		</RowTemplate>
		<NoRecordsContent>
			<MudText>موردی یافت نشد.</MudText>
		</NoRecordsContent>
		<LoadingContent>
			<MudText>Loading...</MudText>
		</LoadingContent>
		<PagerContent>
			<MudTablePager />
		</PagerContent>
	</MudTable>
}

@code {
	enum FormState { None, Create, Edit }
	private FormState formState = FormState.None;
	private int? id = null;

	private LabReportHistorySearchDto searchModel = new();
	private MudTable<LabReportHistoryDisplayDto> table;
	private List<KeyValuePair<int, string>> UsersKeyValue = new();

	NotificationClassName ClassName = NotificationClassName.Success;
	string MessageBody = "عملیات با موفقت انجام شد.";

	protected override async Task OnInitializedAsync()
	{
		var apiResult = await httpHelper
			.GetByFilterAsync<UserSearchDto, ApiResult<List<KeyValuePair<int, string>>>>("api/User/GetByFilterForDropDown", new());

		UsersKeyValue = apiResult?.Data?.ToList() ?? new();
	}

	private async Task<TableData<LabReportHistoryDisplayDto>> ServerReload(TableState state, CancellationToken token)
	{
		searchModel.CalculateTakeAndSkip(state.Page, state.PageSize);
		var apiResult = await httpHelper
			.GetByFilterAsync<LabReportHistorySearchDto, ApiResult<BaseGridDto<LabReportHistoryDisplayDto>>>("api/LabReportHistory/GetByFilter", searchModel);

		var items = apiResult?.Data?.Data ?? Enumerable.Empty<LabReportHistoryDisplayDto>();
		var total = apiResult?.Data?.TotalCount ?? 0;
		return new TableData<LabReportHistoryDisplayDto> { TotalItems = total, Items = items };
	}

	private void OnSearch() => table?.ReloadServerData();

	private void ClearForm()
	{
		searchModel = new LabReportHistorySearchDto();
		OnSearch();
	}

	private void CreateNewItem() => formState = FormState.Create;

	private void EditItem(int itemId)
	{
		this.id = itemId;
		formState = FormState.Edit;
	}

	private async Task DeleteItem(int itemId)
	{
		this.id = itemId;
		formState = FormState.None;

		var confirmResult = await JSRuntime.InvokeAsync<bool>("confirmDelete", "آیا از حذف این آیتم اطمینان دارید؟");
		if (confirmResult)
		{
			var apiResult = await httpHelper.DeleteAsync<ApiResult>($"api/LabReportHistory?id={this.id}");

			if (apiResult?.IsSuccess ?? false)
			{
				ClassName = NotificationClassName.Success;
				MessageBody = "عملیات با موفقت انجام شد.";
			}
			else
			{
				ClassName = NotificationClassName.Error;
				MessageBody = apiResult?.Message ?? "خطایی رخ داده است. لطفا با پشتیبانی تماس بگیرید.";
			}

			await ShowMessage();
			table?.ReloadServerData();
		}
	}

	private async Task HandleCreateCompleted(bool saved)
	{
		formState = FormState.None;
		this.id = null;
		if (!saved) return;

		ClassName = NotificationClassName.Success;
		MessageBody = "عملیات با موفقت انجام شد.";
		await ShowMessage();
		table?.ReloadServerData();
	}

	private Task ShowMessage() => JSRuntime.InvokeVoidAsync("showToast", ClassName.ToDisplay(), MessageBody).AsTask();
	// private void ToDateChanged(DateTime? args)
	// {
	// 	searchModel.ToReportDate = args;
	// }
	// private void FromDateChanged(DateTime? args)
	// {
	// 	searchModel.FromReportDate = args;
	// }
}