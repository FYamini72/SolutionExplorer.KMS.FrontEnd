@inject IHttpService httpHelper

<div>
    <EditForm EditContext="@_createContext" OnValidSubmit="@SaveAsync">
        <DataAnnotationsValidator />

        <input type="hidden" @bind="CreateModel.Id" />

        <div class="mb-3">
            <label class="form-label fw-semibold">
                @(ApplicationHelper.GetDisplayName<UserCreateDto>(nameof(UserCreateDto.FirstName)))
            </label>
            <InputText class="form-control" @bind-Value="CreateModel.FirstName" />
            <ValidationMessage For="@(() => CreateModel.FirstName)" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">
                @(ApplicationHelper.GetDisplayName<UserCreateDto>(nameof(UserCreateDto.LastName)))
            </label>
            <InputText class="form-control" @bind-Value="CreateModel.LastName" />
            <ValidationMessage For="@(() => CreateModel.LastName)" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">
                @(ApplicationHelper.GetDisplayName<UserCreateDto>(nameof(UserCreateDto.UserName)))
            </label>
            <InputText class="form-control" @bind-Value="CreateModel.UserName" />
            <ValidationMessage For="@(() => CreateModel.UserName)" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">
                @(ApplicationHelper.GetDisplayName<UserCreateDto>(nameof(UserCreateDto.Password)))
            </label>
            <InputText class="form-control" @bind-Value="CreateModel.Password" />
            <ValidationMessage For="@(() => CreateModel.Password)" />
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public UserCreateDto CreateModel { get; set; } = new();
    [Parameter] public EventCallback<ApiResult<UserDisplayDto>> OnCompleted { get; set; }

    private EditContext _createContext;

    protected override void OnParametersSet()
    {
        // هر بار که پارامترها تغییر کنن (مثلاً مدل جدید بیاد)، EditContext دوباره ساخته بشه
        _createContext = new EditContext(CreateModel);
    }

    /// <summary>
    /// فراخوانی از والد (مودال) برای ثبت فرم.
    /// </summary>
    public async Task<bool> SubmitAsync()
    {
        // حتماً EditContext رو با آخرین مدل بروزرسانی کن
        if (_createContext.Model != CreateModel)
        {
            _createContext = new EditContext(CreateModel);
        }

        // پاک کردن وضعیت قبلی اعتبارسنجی
        _createContext.NotifyValidationStateChanged();

        // اجرای اعتبارسنجی از نو
        var isValid = _createContext.Validate();

        if (!isValid)
        {
            StateHasChanged(); // اطمینان از رندر دوباره ValidationMessageها
            return false;
        }

        await SaveAsync();
        return true;
    }

    private async Task SaveAsync()
    {
        try
        {
            var result = await httpHelper
                .PostAsync<UserCreateDto, ApiResult<UserDisplayDto>>("api/user/CreateUser", CreateModel);

            await OnCompleted.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            var errorResult = new ApiResult<UserDisplayDto>
            {
                IsSuccess = false,
                Message = $"خطا در ارتباط با سرور: {ex.Message}"
            };
            await OnCompleted.InvokeAsync(errorResult);
        }
    }
}