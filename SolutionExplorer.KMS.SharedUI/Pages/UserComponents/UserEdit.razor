@inject IHttpService _httpService
@inject IJSRuntime _jsRuntime

@if (showSpinner)
{
    <Spinner />
}
else
{
    <div class="container">
        <div class="text-center mt-5">
            <h1>ویرایش کاربر</h1>
        </div>

        <div class="row">
            <div class="col-lg-7 mx-auto">
                <div class="card mt-2 mx-auto p-4 bg-light">
                    <div class="card-body bg-light">
                        <div class="container">
                            <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
                                <DataAnnotationsValidator />
                                <div class="controls">
                                    <input type="hidden" @bind-value="Model.Id" />

                                    <div class="row row-margin-10">
                                        <div class="form-group">
                                            <label>
                                                @(ApplicationHelper.GetDisplayName<UserUpdateDto>(nameof(UserUpdateDto.FirstName)))
                                            </label>
                                            <InputText class="form-control" @bind-Value="Model.FirstName" />
                                            <ValidationMessage For="@(() => Model.FirstName)" />
                                        </div>
                                    </div>

                                    <div class="row row-margin-10">
                                        <div class="form-group">
                                            <label>
                                                @(ApplicationHelper.GetDisplayName<UserUpdateDto>(nameof(UserUpdateDto.LastName)))
                                            </label>
                                            <InputText class="form-control" @bind-Value="Model.LastName" />
                                            <ValidationMessage For="@(() => Model.LastName)" />
                                        </div>
                                    </div>

                                    <div class="row row-margin-10">
                                        <div class="form-group">
                                            <label>
                                                @(ApplicationHelper.GetDisplayName<UserUpdateDto>(nameof(UserUpdateDto.NewPassword)))
                                            </label>
                                            <InputText class="form-control" @bind-Value="Model.NewPassword" />
                                            <ValidationMessage For="@(() => Model.NewPassword)" />
                                        </div>
                                    </div>

                                    <div class="row row-margin-10">
                                        <div class="col-md-6">
                                            <input type="submit" class="btn btn-success btn-send pt-2 btn-block" value="ثبت اطلاعات" />
                                        </div>
                                        <div class="col-md-6">
                                            <button type="button" @onclick="Cancel" class="btn btn-primary btn-send pt-2 btn-block">انصراف</button>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {

    [Parameter] public EventCallback<bool> OnSavedChanges { get; set; }
    [Parameter] public int Id { get; set; }

    public UserUpdateDto Model { get; set; } = new();

    NotificationClassName ClassName = NotificationClassName.Success;
    string MessageBody = "عملیات با موفقت انجام شد.";
    private bool showSpinner;

    protected override async Task OnParametersSetAsync()
    {
        showSpinner = true;

        try
        {
            var apiResult = await _httpService.GetAsync<ApiResult<UserDisplayDto>>($"api/User/{Id}");

            if (apiResult?.IsSuccess ?? false)
            {
                Model = apiResult?.Data?.Adapt<UserUpdateDto>() ?? new UserUpdateDto();
            }
            else
            {
                ClassName = NotificationClassName.Error;
                MessageBody = apiResult?.Message ?? "خطایی رخ داده است. لطفا با پشتیبانی تماس بگیرید.";
                await ShowMessage();
            }
        }
        catch (Exception)
        {
            ClassName = NotificationClassName.Error;
            MessageBody = "خطا در دریافت اطلاعات کاربر.";
            await ShowMessage();
        }
        finally
        {
            showSpinner = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        showSpinner = true;
        try
        {
            var apiResult = await _httpService.PutAsync<UserUpdateDto, ApiResult<UserDisplayDto>>("api/User/UpdateUser", Model);
            if (!apiResult?.IsSuccess ?? false)
            {
                ClassName = NotificationClassName.Error;
                MessageBody = apiResult?.Message ?? "خطایی رخ داده است. لطفا با پشتیبانی تماس بگیرید.";
                await ShowMessage();
                return;
            }

            await OnSavedChanges.InvokeAsync(true);
        }
        catch (Exception)
        {
            ClassName = NotificationClassName.Error;
            MessageBody = "خطایی رخ داده است. لطفا با پشتیبانی تماس بگیرید.";
            await ShowMessage();
        }
        finally
        {
            showSpinner = false;
        }
    }

    private Task Cancel() => OnSavedChanges.InvokeAsync(false);

    private Task ShowMessage() => _jsRuntime.InvokeVoidAsync("showToast", ClassName.ToDisplay(), MessageBody).AsTask();
}