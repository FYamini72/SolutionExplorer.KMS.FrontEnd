@page "/login"
@layout SimpleLayout
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IHttpService HttpService
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<style>
    body {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
        font-family: 'iranyekan', 'Vazir', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: url('/images/main-page-bg.jpg') no-repeat center center fixed;
        /* background: url('/images/login-bg.jpg') no-repeat center center fixed; */
        background-size: cover;
    }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        backdrop-filter: blur(8px);
        background-color: rgba(0, 0, 0, 0.45);
        z-index: -1;
    }

    .login-container {
        width: 100%;
        min-width: 420px;
        min-height: 450px;
        padding: 2.5rem 1.5rem;
        border-radius: 25px 0px 25px 0px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(12px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.3);
        animation: fadeIn 1s ease;
    }

    .login-container h3 {
        font-weight: 700;
        font-size: 1.6rem;
        text-align: center;
        margin-bottom: 2rem;
        color: #fff;
        letter-spacing: 1px;
    }

    .input-group {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .input-group i {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #ccc;
        font-size: 1.2rem;
    }

    .form-control {
        width: 100%;
        border-radius: 12px;
        padding: 0.75rem 2.5rem 0.75rem 1rem;
        border: none;
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
        font-size: 0.95rem;
        transition: 0.3s;
    }

    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.7);
    }

    .form-control:focus {
        background: rgba(255, 255, 255, 0.3);
        outline: none;
        box-shadow: 0 0 8px rgba(0, 123, 255, 0.6);
    }

    .btn-primary {
        background: linear-gradient(135deg, #00c6ff, #0072ff);
        border: none;
        border-radius: 12px;
        padding: 0.85rem;
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #0072ff, #004e92);
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    }

    .extra-links {
        text-align: center;
        margin-top: 1.2rem;
    }

    .extra-links a {
        color: #ddd;
        font-size: 0.9rem;
        text-decoration: none;
        transition: 0.3s;
    }

    .extra-links a:hover {
        color: #fff;
        text-decoration: underline;
    }

    .logo {
        display: block;
        margin: 0 auto 3.5rem auto;
        max-width: 150px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="overlay"></div>

<EditForm Model="@model" OnValidSubmit="@LoginAsync">
    <DataAnnotationsValidator />
    <ValidationSummary Class="alert alert-danger mb-3" />

    <div class="login-container">
        @* <h3>ورود به سیستم</h3> *@

        <img src="images/logo-no-bg(2).png" class="logo" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger text-center mb-3">
                @errorMessage
            </div>
        }

        <div class="input-group">
            <i class="bi bi-person"></i>
            <InputText id="username" class="form-control" @bind-Value="model.UserName" placeholder="نام کاربری" />
        </div>

        <div class="input-group">
            <i class="bi bi-lock"></i>
            <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" placeholder="رمز عبور" />
        </div>

        <button type="submit" class="btn btn-primary w-100">ورود</button>

        @* <div class="extra-links">
            <a href="/forgot-password">فراموشی رمز عبور</a>
        </div> *@
    </div>

</EditForm>

@code {
    private LoginDto model = new();
    private string errorMessage;

    private async Task LoginAsync()
    {
        errorMessage = null;

        var result = await HttpService.PostAsync<LoginDto, ApiResult<UserAndTokenDisplayDto>>(
            "api/User/Login", model, false);

        if (result?.IsSuccess == true && result.Data?.Token != null)
        {
            // ذخیره توکن در LocalStorage
            await LocalStorage.SetItemAsync("authToken", result.Data.Token);

            // اعلام تغییر وضعیت احراز هویت
            if (AuthStateProvider is CustomAuthenticationStateProvider customAuth)
            {
                var claims = new List<Claim>
                {
                    new Claim(ClaimTypes.Name, result.Data.UserName),
                    new Claim("Token", result.Data.Token)
                };

                if (result.Data.UserRoles != null)
                {
                    foreach (var role in result.Data.UserRoles)
                    {
                        claims.Add(new Claim(ClaimTypes.Role, role.RoleTitle));
                    }
                }

                var identity = new ClaimsIdentity(claims, "apiauth");
                var user = new ClaimsPrincipal(identity);
                customAuth.NotifyUserAuthentication(user);
            }

            // هدایت به صفحه اصلی
            Navigation.NavigateTo("/", true);
        }
        else
        {
            errorMessage = result?.Message ?? "ورود ناموفق بود.";
        }
    }
}