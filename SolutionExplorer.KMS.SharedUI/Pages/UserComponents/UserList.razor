@page "/users"
@inject IHttpService httpHelper
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<!-- مودال: دکمه ثبت مودال، Submit فرم داخلی را صدا می‌زند -->
<Modal @ref="modal"
       Title="ویرایش کاربر"
       OnSave="SubmitFromModal"
       OnCancel="CancelEdit"
       IsBusy="@isSaving">

    <!-- فرم ویرایش: منطق ذخیره داخل همین کامپوننت است -->
    <UserEditForm @ref="userForm"
                  EditModel="@editUserModel"
                  OnCompleted="HandleFormCompleted" />
</Modal>

<div class="accordion" id="accordionFlushExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
                فرم جستجو کاربران
            </button>
        </h2>
        <div id="flush-collapseOne" class="accordion-collapse collapse" aria-labelledby="flush-headingOne" data-bs-parent="#accordionFlushExample">
            <div class="accordion-body">
                <form class="row g-3" @onreset="ClearForm">
                    <!-- نام کاربری -->
                    <div class="col-md-4 col-sm-6">
                        <label class="form-label fw-semibold">
                            @(ApplicationHelper.GetDisplayName<UserSearchDto>(nameof(UserSearchDto.UserName)))
                        </label>
                        <input type="text"
                               class="form-control"
                               @bind="searchModel.UserName"
                               placeholder="مثلاً: admin" />
                    </div>

                    <!-- نام -->
                    <div class="col-md-4 col-sm-6">
                        <label class="form-label fw-semibold">
                            @(ApplicationHelper.GetDisplayName<UserSearchDto>(nameof(UserSearchDto.FirstName)))
                        </label>
                        <input type="text"
                               class="form-control"
                               @bind="searchModel.FirstName"
                               placeholder="مثلاً: علی" />
                    </div>

                    <!-- نام خانوادگی -->
                    <div class="col-md-4 col-sm-6">
                        <label class="form-label fw-semibold">
                            @(ApplicationHelper.GetDisplayName<UserSearchDto>(nameof(UserSearchDto.LastName)))
                        </label>
                        <input type="text"
                               class="form-control"
                               @bind="searchModel.LastName"
                               placeholder="مثلاً: رضایی" />
                    </div>

                    <!-- دکمه‌ها -->
                    <div class="col-12 text-end mt-3">
                        <button type="reset"
                                class="btn btn-outline-secondary px-4 me-2">
                            <i class="fas fa-times me-1"></i> پاک کردن
                        </button>
                        <button type="button"
                                class="btn btn-primary px-4"
                                @onclick="OnSearch">
                            <i class="fas fa-search me-1"></i> جستجو
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<MudTable ServerData="ServerReload" Dense="false" Hover="true" @ref="table">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="@(nameof(UserDisplayDto.UserName))" T="UserDisplayDto">@(ApplicationHelper.GetDisplayName<UserDisplayDto>(nameof(UserDisplayDto.UserName)))</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="@(nameof(UserDisplayDto.FirstName))" T="UserDisplayDto">@(ApplicationHelper.GetDisplayName<UserDisplayDto>(nameof(UserDisplayDto.FirstName)))</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="@(nameof(UserDisplayDto.LastName))" T="UserDisplayDto">@(ApplicationHelper.GetDisplayName<UserDisplayDto>(nameof(UserDisplayDto.LastName)))</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserDisplayDto">عملیات</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@(nameof(UserDisplayDto.UserName))">@context.UserName</MudTd>
        <MudTd DataLabel="@(nameof(UserDisplayDto.FirstName))">@context.FirstName</MudTd>
        <MudTd DataLabel="@(nameof(UserDisplayDto.LastName))">@context.LastName</MudTd>
        <MudTd DataLabel="@(nameof(UserDisplayDto.Id))">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Medium" OnClick="@(() => DeleteItem(context.Id))"></MudIconButton>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Medium" OnClick="@(() => EditItem(context))"></MudIconButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No matching records found</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    private UserSearchDto searchModel = new();
    private IEnumerable<UserDisplayDto> pagedData;
    private MudTable<UserDisplayDto> table;

    private Modal modal;
    private UserEditForm userForm;                  // ⬅️ ref به فرم
    private UserUpdateDto editUserModel = new();

    private bool isSaving = false;                  // ⬅️ برای غیرفعال‌کردن دکمه‌های مودال هنگام ذخیره

    NotificationClassName ClassName = NotificationClassName.Success;
    string MessageBody = "عملیات با موفقت انجام شد.";

    private async Task<TableData<UserDisplayDto>> ServerReload(TableState state, CancellationToken token)
    {
        searchModel.CalculateTakeAndSkip(state.Page, state.PageSize);
        var apiResult = await httpHelper
            .GetByFilterAsync<UserSearchDto, ApiResult<BaseGridDto<UserDisplayDto>>>(
                "api/user/GetByFilter",
                searchModel);

        pagedData = apiResult?.Data?.Data ?? new List<UserDisplayDto>();
        var totalItems = apiResult?.Data?.TotalCount ?? 0;
        return new TableData<UserDisplayDto>() { TotalItems = totalItems, Items = pagedData };
    }

    private void OnSearch() => table.ReloadServerData();

    private void ClearForm()
    {
        searchModel = new UserSearchDto();
        // Blazor خودش StateHasChanged را بعد از reset فراخوانی می‌کند
    }

    private async Task EditItem(UserDisplayDto item)
    {
        editUserModel = new UserUpdateDto
        {
            Id = item.Id,
            FirstName = item.FirstName,
            LastName = item.LastName
        };

        await modal.Show();
    }

    // ⬅️ این متد با کلیک روی دکمه "ثبت" مودال صدا زده می‌شود
    private async Task SubmitFromModal()
    {
        isSaving = true;
        StateHasChanged();

        var saved = await userForm.SubmitAsync();

        if (!saved)
        {
            // فرم نامعتبر است، فقط حالت busy برداشته شود و پیام زیر فیلد باقی بماند
            isSaving = false;
            StateHasChanged();
            return;
        }

        // SaveAsync داخل فرم خودش OnCompleted را صدا زده، HandleFormCompleted نتیجه را مدیریت می‌کند
    }

    // ⬅️ نتیجه ذخیره از خود فرم می‌آید
    private async Task HandleFormCompleted(ApiResult<UserDisplayDto> result)
    {
        isSaving = false;

        if (result?.IsSuccess ?? false)
        {
            MessageBody = "عملیات با موفقیت انجام شد.";
            ClassName = NotificationClassName.Success;

            await table.ReloadServerData(); // بروزرسانی لیست
            await modal.Hide();             // بستن مودال بعد از موفقیت
        }
        else
        {
            MessageBody = result?.Message ?? "خطا در ویرایش کاربر.";
            ClassName = NotificationClassName.Error;
            // مودال باز می‌ماند تا کاربر خطا را اصلاح کند
        }

        await ShowMessage();
    }

    private Task CancelEdit()
    {
        // در صورت نیاز می‌توانید مدل و وضعیت‌ها را بازنشانی کنید
        return Task.CompletedTask;
    }

    private async Task DeleteItem(int id)
    {
        // TODO: منطق حذف
        MessageBody = $"Deleting item with ID: {id}";
        await ShowMessage();
    }

    private async Task ShowMessage()
    {
        await JSRuntime.InvokeVoidAsync("showToast", ClassName.ToDisplay(), MessageBody);
    }
}