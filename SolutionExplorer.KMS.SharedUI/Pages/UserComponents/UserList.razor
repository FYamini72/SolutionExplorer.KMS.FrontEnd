@page "/users"
@inject IHttpService httpHelper
@inject IJSRuntime JSRuntime
@attribute [Authorize]

@if (formState == FormState.Create)
{
    <UserCreate OnSavedChanges="HandleCreateCompleted" />
}
else if (formState == FormState.Edit)
{
    <UserEdit OnSavedChanges="HandleCreateCompleted" Id="@id" />
}
else
{
    <div class="mb-3 d-flex flex-wrap gap-2">
        <button class="btn btn-outline-info btn-sm" type="button" @onclick="OnSearch">
            <span aria-hidden="true" style="vertical-align: sub;" class="bi bi-arrow-clockwise"></span>
        </button>

        <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#searchFormCollapse" aria-expanded="false" aria-controls="searchFormCollapse">
            <i class="bi bi-search"></i> 
            فرم جستجو
        </button>

        <button class="btn btn-success btn-sm" @onclick="CreateNewItem">
            <i class="bi bi-plus-circle"></i>
            درج رکورد جدید
        </button>
    </div>

    <div class="collapse" id="searchFormCollapse">
        <div class="card card-body mb-4 shadow-sm">
            <form class="row g-3" @onreset="ClearForm">
                <div class="col-md-4 col-sm-6">
                    <label class="form-label fw-semibold">
                        @(ApplicationHelper.GetDisplayName<UserSearchDto>(nameof(UserSearchDto.UserName)))
                    </label>
                    <input type="text" class="form-control" @bind="searchModel.UserName" placeholder="مثلاً: admin" />
                </div>

                <div class="col-md-4 col-sm-6">
                    <label class="form-label fw-semibold">
                        @(ApplicationHelper.GetDisplayName<UserSearchDto>(nameof(UserSearchDto.FirstName)))
                    </label>
                    <input type="text" class="form-control" @bind="searchModel.FirstName" placeholder="مثلاً: علی" />
                </div>

                <div class="col-md-4 col-sm-6">
                    <label class="form-label fw-semibold">
                        @(ApplicationHelper.GetDisplayName<UserSearchDto>(nameof(UserSearchDto.LastName)))
                    </label>
                    <input type="text" class="form-control" @bind="searchModel.LastName" placeholder="مثلاً: رضایی" />
                </div>

                <div class="col-12 text-end mt-3">
                    <button type="reset" class="btn btn-outline-secondary px-4 me-2">
                        <i class="bi bi-trash"></i> پاک کردن
                    </button>
                    <button type="button" class="btn btn-primary px-4" @onclick="OnSearch">
                        <i class="bi bi-search"></i> جستجو
                    </button>
                </div>
            </form>
        </div>
    </div>

    <MudTable ServerData="ServerReload" Dense="true" Striped="true" Hover="true" @ref="table">
        <HeaderContent>
            <MudTh>@(ApplicationHelper.GetDisplayName<UserDisplayDto>(nameof(UserDisplayDto.UserName)))</MudTh>
            <MudTh>@(ApplicationHelper.GetDisplayName<UserDisplayDto>(nameof(UserDisplayDto.FirstName)))</MudTh>
            <MudTh>@(ApplicationHelper.GetDisplayName<UserDisplayDto>(nameof(UserDisplayDto.LastName)))</MudTh>
            <MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@(nameof(UserDisplayDto.UserName))">@context.UserName</MudTd>
            <MudTd DataLabel="@(nameof(UserDisplayDto.FirstName))">@context.FirstName</MudTd>
            <MudTd DataLabel="@(nameof(UserDisplayDto.LastName))">@context.LastName</MudTd>
            <MudTd DataLabel="@(nameof(UserDisplayDto.Id))">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Medium" OnClick="@(() => EditItem(context.Id))"></MudIconButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No matching records found</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}

@code {
    enum FormState { None, Create, Edit }
    private FormState formState = FormState.None;
    private int id;

    private UserSearchDto searchModel = new();
    private MudTable<UserDisplayDto> table;

    NotificationClassName ClassName = NotificationClassName.Success;
    string MessageBody = "عملیات با موفقت انجام شد.";

    private async Task<TableData<UserDisplayDto>> ServerReload(TableState state, CancellationToken token)
    {
        searchModel.CalculateTakeAndSkip(state.Page, state.PageSize);
        var apiResult = await httpHelper
            .GetByFilterAsync<UserSearchDto, ApiResult<BaseGridDto<UserDisplayDto>>>("api/user/GetByFilter", searchModel);

        var items = apiResult?.Data?.Data ?? Enumerable.Empty<UserDisplayDto>();
        var total = apiResult?.Data?.TotalCount ?? 0;
        return new TableData<UserDisplayDto> { TotalItems = total, Items = items };
    }

    private void OnSearch() => table?.ReloadServerData();

    private void ClearForm()
    {
        searchModel = new UserSearchDto();
        OnSearch();
    }

    private void CreateNewItem() => formState = FormState.Create;

    private void EditItem(int itemId)
    {
        this.id = itemId;
        formState = FormState.Edit;
    }

    private async Task HandleCreateCompleted(bool saved)
    {
        formState = FormState.None;
        if (!saved) return;

        ClassName = NotificationClassName.Success;
        MessageBody = "عملیات با موفقت انجام شد.";
        await ShowMessage();
        table?.ReloadServerData();
    }

    private Task ShowMessage() => JSRuntime.InvokeVoidAsync("showToast", ClassName.ToDisplay(), MessageBody).AsTask();
}
