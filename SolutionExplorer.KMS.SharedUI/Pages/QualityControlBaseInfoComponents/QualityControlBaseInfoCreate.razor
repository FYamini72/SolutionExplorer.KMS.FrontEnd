												@(ApplicationHelper.GetDisplayName<QualityControlBaseInfoCreateDto>(nameof(QualityControlBaseInfoCreateDto.Manufacturer)))
											</label>
											<InputText class="form-control" @bind-Value="Model.Manufacturer" />
											<ValidationMessage For="@(() => Model.Manufacturer)" />
										</div>
										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<QualityControlBaseInfoCreateDto>(nameof(QualityControlBaseInfoCreateDto.Series)))
											</label>
											<InputText class="form-control" @bind-Value="Model.Series" />
											<ValidationMessage For="@(() => Model.Series)" />
										</div>
									</div>
 *@@* 
									<div class="row row-margin-10">
										<div class="form-group col-md-4">
											<label>
												@(ApplicationHelper.GetDisplayName<QualityControlBaseInfoCreateDto>(nameof(QualityControlBaseInfoCreateDto.ProductionDate)))
											</label>
											<PersianDatePicker Value="@Model.ProductionDate"
															   ValueChanged="@((val) => Model.ProductionDate = val ?? DateTime.Now)"
															   Required="true"
															   ShowToolbar="false" />
										</div>
									
										<div class="form-group col-md-4">
											<label>
												@(ApplicationHelper.GetDisplayName<QualityControlBaseInfoCreateDto>(nameof(QualityControlBaseInfoCreateDto.ExpirationDate)))
											</label>
											<PersianDatePicker Value="@Model.ExpirationDate"
															   ValueChanged="@((val) => Model.ExpirationDate = val ?? DateTime.Now)"
															   Required="true"
															   ShowToolbar="false" />
										</div>

										<div class="form-group col-md-4">
											<label>
												@(ApplicationHelper.GetDisplayName<QualityControlBaseInfoCreateDto>(nameof(QualityControlBaseInfoCreateDto.Category)))
											</label>
											<InputSelect class="form-select" @bind-value="Model.Category">
												<option value="">انتخاب کنید...</option>
												@foreach (var item in Enum.GetValues<QCCategory>())
												{
													<option value="@item">@item.ToDisplay()</option>
												}
											</InputSelect>
											<ValidationMessage For="@(() => Model.Category)" />
										</div>
