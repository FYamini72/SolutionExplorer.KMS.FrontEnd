@code {
	[Parameter] public EventCallback<bool> OnSavedChanges { get; set; }
	[Parameter] public int? Id { get; set; } = null;

	public QualityControlBaseInfoCreateDto Model { get; set; } = new();
	private List<KeyValuePair<int, string>> UsersKeyValue = new();

	NotificationClassName ClassName = NotificationClassName.Success;
	string MessageBody = "عملیات با موفقت انجام شد.";
	private bool showSpinner;

	protected override async Task OnParametersSetAsync()
	{
		if (!Id.HasValue)
		{
			// Model.ProductionDate = DateTime.Now;
			// Model.ExpirationDate = DateTime.Now;
			return;
		}

		showSpinner = true;

		try
		{
			var apiResult = await _httpService.GetAsync<ApiResult<QualityControlBaseInfoDisplayDto>>($"api/QualityControlBaseInfo/{Id}");

			if (apiResult?.IsSuccess ?? false)
			{
				Model = apiResult?.Data?.Adapt<QualityControlBaseInfoCreateDto>() ?? new();
			}
			else
			{
				ClassName = NotificationClassName.Error;
				MessageBody = apiResult?.Message ?? "خطایی رخ داده است. لطفا با پشتیبانی تماس بگیرید.";
				await ShowMessage();
			}
		}
		catch (Exception)
		{
			ClassName = NotificationClassName.Error;
			MessageBody = "خطا در دریافت اطلاعات گزارش آزمایش.";
			await ShowMessage();
		}
		finally
		{
			showSpinner = false;
		}
	}

	protected override async Task OnInitializedAsync()
	{
		var apiResult = await _httpService
			.GetByFilterAsync<UserSearchDto, ApiResult<List<KeyValuePair<int, string>>>>("api/User/GetByFilterForDropDown", new());

		UsersKeyValue = apiResult?.Data?.ToList() ?? new();
	}

	private async Task HandleValidSubmit()
	{
		showSpinner = true;
		try
		{
			ApiResult<QualityControlBaseInfoDisplayDto>? apiResult = null;

			if (Model.Id > 0)
				apiResult = await _httpService.PutAsync<QualityControlBaseInfoCreateDto, ApiResult<QualityControlBaseInfoDisplayDto>>("api/QualityControlBaseInfo", Model);
			else
				apiResult = await _httpService.PostAsync<QualityControlBaseInfoCreateDto, ApiResult<QualityControlBaseInfoDisplayDto>>("api/QualityControlBaseInfo", Model);

			if (!apiResult?.IsSuccess ?? false)
			{
				ClassName = NotificationClassName.Error;
				MessageBody = apiResult?.Message ?? "خطایی رخ داده است. لطفا با پشتیبانی تماس بگیرید.";
				await ShowMessage();
				return;
			}

			await OnSavedChanges.InvokeAsync(true);
		}
		catch (Exception)
		{
			ClassName = NotificationClassName.Error;
			MessageBody = "خطایی رخ داده است. لطفا با پشتیبانی تماس بگیرید.";
			await ShowMessage();
		}
		finally
		{
			showSpinner = false;
		}
	}

	private Task Cancel() => OnSavedChanges.InvokeAsync(false);

	private Task ShowMessage() => _jsRuntime.InvokeVoidAsync("showToast", ClassName.ToDisplay(), MessageBody).AsTask();
}