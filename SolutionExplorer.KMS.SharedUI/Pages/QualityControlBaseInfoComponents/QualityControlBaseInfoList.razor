			<MudTh>@(ApplicationHelper.GetDisplayName<QualityControlBaseInfoDisplayDto>(nameof(QualityControlBaseInfoDisplayDto.Title)))</MudTh>
			@* <MudTh>@(ApplicationHelper.GetDisplayName<QualityControlBaseInfoDisplayDto>(nameof(QualityControlBaseInfoDisplayDto.Manufacturer)))</MudTh>
			<MudTh>@(ApplicationHelper.GetDisplayName<QualityControlBaseInfoDisplayDto>(nameof(QualityControlBaseInfoDisplayDto.Series)))</MudTh>
			<MudTh>@(ApplicationHelper.GetDisplayName<QualityControlBaseInfoDisplayDto>(nameof(QualityControlBaseInfoDisplayDto.ProductionDate)))</MudTh>
