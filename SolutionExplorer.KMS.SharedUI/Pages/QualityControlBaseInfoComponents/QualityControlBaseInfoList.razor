@code {
	enum FormState { None, Create, Edit/* , SetDefaultValue, DoQualityControl */ }
	private FormState formState = FormState.None;
	private int? id = null;

	[Parameter]
	public int? QualityControlPeriodId { get; set; }

	private QualityControlBaseInfoSearchDto searchModel = new();
	private MudTable<QualityControlBaseInfoDisplayDto> table;

	NotificationClassName ClassName = NotificationClassName.Success;
	string MessageBody = "عملیات با موفقت انجام شد.";

	// protected override async Task OnParametersSetAsync()
	// {
	// 	if (QualityControlPeriodId.HasValue)
	// 		searchModel.QualityControlPeriod = (QualityControlPeriod)QualityControlPeriodId;
	// 	else if ((await localStorageService.ContainsKeyAsync("QualityControlPeriod")))
	// 		searchModel.QualityControlPeriod = (QualityControlPeriod)((await localStorageService.GetItemAsync<int>("QualityControlPeriod")));
	// 	else
	// 		searchModel.QualityControlPeriod = null;

	// 	table?.ReloadServerData();
	// 	return base.OnParametersSetAsync();
	// }

	protected override async Task OnParametersSetAsync()
	{
		if (QualityControlPeriodId.HasValue)
			searchModel.QualityControlPeriod = (QualityControlPeriod)QualityControlPeriodId;
		else if (await localStorageService.ContainsKeyAsync("QualityControlPeriod"))
		{
			searchModel.QualityControlPeriod = (QualityControlPeriod)(await localStorageService.GetItemAsync<int>("QualityControlPeriod"));
			await localStorageService.RemoveItemAsync("QualityControlPeriod");
		}
		else
			searchModel.QualityControlPeriod = null;

		table?.ReloadServerData();

		await base.OnParametersSetAsync();
	}


	private async Task<TableData<QualityControlBaseInfoDisplayDto>> ServerReload(TableState state, CancellationToken token)
	{
		searchModel.CalculateTakeAndSkip(state.Page, state.PageSize);
		var apiResult = await httpHelper
			.GetByFilterAsync<QualityControlBaseInfoSearchDto, ApiResult<BaseGridDto<QualityControlBaseInfoDisplayDto>>>("api/QualityControlBaseInfo/GetByFilter", searchModel);

		var items = apiResult?.Data?.Data ?? Enumerable.Empty<QualityControlBaseInfoDisplayDto>();
		var total = apiResult?.Data?.TotalCount ?? 0;
		return new TableData<QualityControlBaseInfoDisplayDto> { TotalItems = total, Items = items };
	}

	private void OnSearch()
	{
		if (searchModel.QualityControlPeriod != QualityControlPeriod.Periodic)
		{
			searchModel.DayIntervalCount = null;
		}

		table?.ReloadServerData();
	}

	private void ClearForm()
	{
		searchModel = new QualityControlBaseInfoSearchDto();
		OnSearch();
	}

	private void CreateNewItem() => formState = FormState.Create;

	// private void SetDefaultValue(int itemId)
	// {
	// 	this.id = itemId;
	// 	formState = FormState.SetDefaultValue;
	// }

	private void EditItem(int itemId)
	{
		this.id = itemId;
		formState = FormState.Edit;
	}

	private void InfoItem(int itemId)
	{
		this.id = itemId;
		if (searchModel.QualityControlPeriod.HasValue)
		{
			localStorageService.SetItemAsync<int>("QualityControlPeriod", (int)searchModel.QualityControlPeriod.Value);
		}
		Navigation.NavigateTo($"/QualityControls/{id}", true);
	}

	// private void DoQualityControl(int itemId)
	// {
	// 	this.id = itemId;
	// 	formState = FormState.DoQualityControl;
	// }

	private async Task DeleteItem(int itemId)
	{
		this.id = itemId;
		formState = FormState.None;

		var confirmResult = await JSRuntime.InvokeAsync<bool>("confirmDelete", "آیا از حذف این آیتم اطمینان دارید؟");
		if (confirmResult)
		{
			var apiResult = await httpHelper.DeleteAsync<ApiResult>($"api/QualityControlBaseInfo?id={this.id}");

			if (apiResult?.IsSuccess ?? false)
			{
				ClassName = NotificationClassName.Success;
				MessageBody = "عملیات با موفقت انجام شد.";
			}
			else
			{
				ClassName = NotificationClassName.Error;
				MessageBody = apiResult?.Message ?? "خطایی رخ داده است. لطفا با پشتیبانی تماس بگیرید.";
			}

			await ShowMessage();
			table?.ReloadServerData();
		}
	}

	private async Task HandleCreateCompleted(bool saved)
	{
		formState = FormState.None;
		this.id = null;
		if (!saved) return;

		ClassName = NotificationClassName.Success;
		MessageBody = "عملیات با موفقت انجام شد.";
		await ShowMessage();
		table?.ReloadServerData();
	}

	private Task ShowMessage() => JSRuntime.InvokeVoidAsync("showToast", ClassName.ToDisplay(), MessageBody).AsTask();
}
