				<MudIconButton Icon="@Icons.Material.Filled.Edit" hidden="@(QualityControlPeriodId.HasValue)" Color="Color.Primary" Size="Size.Medium" OnClick="@(() => EditItem(context.Id))"></MudIconButton>
				<MudIconButton Icon="@Icons.Material.Filled.Delete" hidden="@(QualityControlPeriodId.HasValue)" Color="Color.Error" Size="Size.Medium" OnClick="@(() => DeleteItem(context.Id))"></MudIconButton>
