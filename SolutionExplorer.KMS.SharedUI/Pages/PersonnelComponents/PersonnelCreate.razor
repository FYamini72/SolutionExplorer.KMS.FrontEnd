@using SolutionExplorer.KMS.SharedUI.Dtos.PersonnelDtos
@if (showSpinner)
{
	<Spinner />
}
else
{
	<div class="container">
		<div class="text-center mt-5">
			<h1 class="page-title">
				ایجاد پرسنل جدید
			</h1>
		</div>

		<div class="row">
			<div class="col-lg-10 mx-auto">
				<div class="card mt-2 mx-auto beauty-card">
					<div class="card-body bg-light">
						<div class="container">
							<EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
								<DataAnnotationsValidator />

								<div class="controls">
									@if (Id.HasValue)
									{
										<div class="alert alert-info">
											در صورت خالی گذاشتن رمز عبور، تصویر پروفایل یا امضا،
											مقادیر قبلی بدون تغییر باقی می‌مانند.
										</div>
									}
									<!-- User Info -->
									<div class="row row-margin-10">
										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.UserName)))
											</label>
											<InputText class="form-control" @bind-Value="Model.UserName" disabled="@(Id.HasValue)" />
											<ValidationMessage For="@(() => Model.UserName)" />
										</div>

										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.RoleIds)))
											</label>
											
											<select multiple class="form-select" size="1" @onchange="OnRoleSelectionChanged">
												@foreach (var role in RolesKeyValue)
												{
													<option value="@role.Key"
															selected="@(Model.RoleIds.Contains(role.Key))">
														@role.Value
													</option>
												}
											</select>
										</div>
									</div>

									<div class="row row-margin-10">
										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.Password)))
											</label>
											<InputText type="password" class="form-control" @bind-Value="Model.Password" />
											<ValidationMessage For="@(() => Model.Password)" />
										</div>

										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.RePassword)))
											</label>
											<InputText type="password" class="form-control" @bind-Value="Model.RePassword" />
											<ValidationMessage For="@(() => Model.RePassword)" />
										</div>
									</div>

									<div class="row row-margin-10">
										<div class="form-group col-md-4">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.FirstName)))
											</label>
											<InputText class="form-control" @bind-Value="Model.FirstName" />
											<ValidationMessage For="@(() => Model.FirstName)" />
										</div>

										<div class="form-group col-md-4">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.LastName)))
											</label>
											<InputText class="form-control" @bind-Value="Model.LastName" />
											<ValidationMessage For="@(() => Model.LastName)" />
										</div>

										<div class="form-group col-md-4">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.PersonnelNumber)))
											</label>
											<InputText class="form-control" @bind-Value="Model.PersonnelNumber" />
											<ValidationMessage For="@(() => Model.PersonnelNumber)" />
										</div>

									</div>

									<!-- Enums -->
									<div class="row row-margin-10">
										<div class="form-group col-md-4">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.Prefix)))
											</label>
											<InputSelect class="form-select" @bind-Value="Model.Prefix">
												<option value="">انتخاب کنید...</option>
												@foreach (var item in Enum.GetValues<Prefix>())
												{
													<option value="@item">@item.ToDisplay()</option>
												}
											</InputSelect>
											<ValidationMessage For="@(() => Model.Prefix)" />
										</div>

										<div class="form-group col-md-4">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.Gender)))
											</label>
											<InputSelect class="form-select" @bind-Value="Model.Gender">
												<option value="">انتخاب کنید...</option>
												@foreach (var item in Enum.GetValues<Gender>())
												{
													<option value="@item">@item.ToDisplay()</option>
												}
											</InputSelect>
											<ValidationMessage For="@(() => Model.Gender)" />
										</div>

										<div class="form-group col-md-4">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.Position)))
											</label>
											<InputSelect class="form-select" @bind-Value="Model.Position">
												<option value="">انتخاب کنید...</option>
												@foreach (var item in Enum.GetValues<Enums.Position>())
												{
													<option value="@item">@item.ToDisplay()</option>
												}
											</InputSelect>
											<ValidationMessage For="@(() => Model.Position)" />
										</div>
									</div>

									<div class="row row-margin-10">
										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.EducationalDegree)))
											</label>
											<InputSelect class="form-select" @bind-Value="Model.EducationalDegree">
												<option value="">انتخاب کنید...</option>
												@foreach (var item in Enum.GetValues<EducationalDegree>())
												{
													<option value="@item">@item.ToDisplay()</option>
												}
											</InputSelect>
											<ValidationMessage For="@(() => Model.EducationalDegree)" />
										</div>

										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.EducationalField)))
											</label>
											<InputText class="form-control" @bind-Value="Model.EducationalField" />
										</div>
									</div>

									<!-- Users -->
									<div class="row row-margin-10">
										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.FirstConfirmerUserId)))
											</label>
											<InputSelect class="form-select" @bind-Value="Model.FirstConfirmerUserId">
												<option value="">انتخاب کنید...</option>
												@foreach (var user in UsersKeyValue)
												{
													<option value="@user.Key">@user.Value</option>
												}
											</InputSelect>
										</div>

										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.SecondConfirmerUserId)))
											</label>
											<InputSelect class="form-select" @bind-Value="Model.SecondConfirmerUserId">
												<option value="">انتخاب کنید...</option>
												@foreach (var user in UsersKeyValue)
												{
													<option value="@user.Key">@user.Value</option>
												}
											</InputSelect>
										</div>
									</div>
									
									<!-- Users -->
									<div class="row row-margin-10">
										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.SuccessorUserId)))
											</label>
											<InputSelect class="form-select" @bind-Value="Model.SuccessorUserId">
												<option value="">انتخاب کنید...</option>
												@foreach (var user in UsersKeyValue)
												{
													<option value="@user.Key">@user.Value</option>
												}
											</InputSelect>
										</div>

										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.EmploymentDate)))
											</label>
											<PersianDatePicker Value="@Model.EmploymentDate"
															   ValueChanged="@((val) => Model.EmploymentDate = val ?? DateTime.Now)"
															   Required="true"
															   ShowToolbar="false" />
										</div>
									</div>

									<!-- Files -->
									<div class="row row-margin-10">
										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.ProfileSelectedFile)))
											</label>
											<InputFile class="form-control" OnChange="HandleProfileFileSelected" />
										</div>

										<div class="form-group col-md-6">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.SignatureSelectedFile)))
											</label>
											<InputFile class="form-control" OnChange="HandleSignatureFileSelected" />
										</div>
									</div>

									<!-- Text fields -->
									<div class="row row-margin-10">
										<div class="form-group col-md-12">
											<label>
												@(ApplicationHelper.GetDisplayName<PersonnelCreateDto>(nameof(PersonnelCreateDto.OrganizationalChart)))
											</label>
											<InputTextArea class="form-control" @bind-Value="Model.OrganizationalChart" />
										</div>
									</div>

									<!-- Actions -->
									<div class="row row-margin-10">
										<div class="col-md-6">
											<input type="submit" class="btn btn-success btn-send pt-2 btn-block" value="ثبت اطلاعات" />
										</div>
										<div class="col-md-6">
											<button type="button" class="btn btn-primary btn-send pt-2 btn-block" @onclick="Cancel">
												انصراف
											</button>
										</div>
									</div>

								</div>
							</EditForm>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
